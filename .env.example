# Copy to .env and adjust. Every value here has a working default;
# .env exists to override, not to be required.

# State directory: the default base for VITALS_DB and VITALS_TOKEN_FILE below.
# VITALS_STATE_DIR=/Users/<you>/Library/Application Support/vitals

# Where the SQLite store lives. MUST stay outside both git repos.
# VITALS_DB=/Users/<you>/Library/Application Support/vitals/vitals.db

# Where the shared credential lives (chmod 600, minted by `npm run token:mint`).
# VITALS_TOKEN_FILE=/Users/<you>/Library/Application Support/vitals/token

# The header healthd is configured to send. Name and value are both the
# owner's choice in the app; this must match what is typed there.
# VITALS_TOKEN_HEADER=x-vitals-token

# Listeners. Ingest is LAN-facing and write-only; the read side is loopback.
# VITALS_INGEST_HOST=0.0.0.0
# VITALS_INGEST_PORT=4781
# VITALS_READ_HOST=127.0.0.1
# VITALS_READ_PORT=4780

# Request body cap. healthd keeps a batch under 1 MB; this is headroom, and
# anything above it is answered 413 (a permanent configuration error).
# VITALS_MAX_BODY_BYTES=2000000

# A run with no final batch and no traffic for this long is "truncated".
# VITALS_TRUNCATED_AFTER_MINUTES=60

# Shutdown drain cap: the longest a stop (SIGTERM, restart) waits for requests
# in flight before closing what is left. Seconds, must be > 0.
# VITALS_DRAIN_CAP_SECONDS=10

# --- the fitness page at / ---------------------------------------------------

# Ring goals. Apple's are per-person; these are the page's, and they are printed
# next to every ring so the number is never a mystery.
# VITALS_GOAL_MOVE_KCAL=600
# VITALS_GOAL_EXERCISE_MIN=30
# VITALS_GOAL_STAND_HOURS=12

# The third ring: stand | sleep | off. Substituting sleep for stand rebrands
# Apple's ring set, so it is opt-in and deliberately not cleverer than this.
# VITALS_THIRD_RING=stand

# Which device wins a day for cumulative types, as source-id prefixes, highest
# priority first. Unset means the highest total that day wins -- which follows
# whichever device was actually on the body.
# VITALS_SOURCE_PRIORITY=com.apple.health,com.example.watch

# Friendly names for sources: prefix=Name, comma separated. The full bundle id
# is always available in a title attribute regardless.
# VITALS_SOURCE_NAMES=com.example.watch=Watch

# Meta refresh on / only. 0 switches it off. A wall-mounted dashboard that never
# updates is a poster.
# VITALS_AUTO_REFRESH_SECONDS=300
