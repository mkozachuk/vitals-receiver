{
  "name": "vitals",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Receiver for healthd Apple Health exports: LAN ingest, loopback dashboard, SQLite outside the repo",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "demo": "tsx scripts/demo.ts",
    "silence:check": "tsx scripts/silence-check.ts",
    "deliveries": "tsx scripts/deliveries.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "token:mint": "tsx scripts/mint-token.ts",
    "service:install": "bash scripts/service-install.sh",
    "service:uninstall": "bash scripts/service-uninstall.sh",
    "service:verify": "bash scripts/verify-service.sh",
    "service:logs": "tail -f \"$HOME/Library/Logs/vitals/vitals.log\"",
    "restart": "launchctl kickstart -k gui/$(id -u)/local.vitals.daemon"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "fastify": "^5.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
